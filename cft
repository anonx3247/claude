#!/bin/bash

# cft - Claude Feature Tool
# Creates a git worktree with Claude integration for automated development

set -e

if [ -z "$1" ]; then
  echo "Usage: cft <branch-name>"
  echo "Example: cft fix-bug-123"
  exit 1
fi

feature_name="$1"

# Validate we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
  echo "Error: Not in a git repository"
  exit 1
fi

# Get project directory and name
project_dir=$(git rev-parse --show-toplevel)
project=$(basename "$project_dir")
cd "$project_dir"

# Define paths
feature_path="../${project}-${feature_name}"
prompt_file="/tmp/claude-prompt-${feature_name}.md"

# Ensure cleanup on exit
trap 'rm -f "$prompt_file"' EXIT

# Check if branch exists, create only if it doesn't
if ! git show-ref --verify --quiet refs/heads/"$feature_name"; then
  echo "Creating branch: $feature_name"
  git branch "$feature_name"
else
  echo "Branch already exists: $feature_name"
fi

# Check if worktree exists, create only if it doesn't
if [ ! -d "$feature_path" ]; then
  echo "Creating worktree at: $feature_path"
  git worktree add "$feature_path" "$feature_name"
else
  echo "Worktree already exists at: $feature_path"
fi

# Create a temporary file for the prompt
cat > "$prompt_file" << 'TEMPLATE_EOF'
# Claude Instructions

## Branch
BRANCH_NAME

## Task Description
Write your specific task instructions below. Be as detailed as needed.
If you leave this empty (delete these lines), Claude will infer 
the task from the branch name.

## Instructions

[Your instructions here]

Examples:
- "Add user authentication with JWT tokens and bcrypt password hashing"
- "Fix the memory leak in the image processing module"
- "Refactor the API client to use async/await pattern"

TEMPLATE_EOF

# Replace placeholder with actual branch name
sed -i "s/BRANCH_NAME/$feature_name/" "$prompt_file" 2>/dev/null || sed -i '' "s/BRANCH_NAME/$feature_name/" "$prompt_file"

# Open editor for user to write prompt
echo ""
echo "Opening editor for instructions..."
echo "Save and close when done."
echo ""
${EDITOR:-hx} "$prompt_file"

# Read the prompt (skip header lines and extract actual content)
user_prompt=$(grep -v '^#' "$prompt_file" | grep -v '^\[' | grep -v '^Examples:' | sed '/^$/d' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

# If prompt is empty, use branch name as context
if [ -z "$user_prompt" ]; then
  echo "No specific instructions provided."
  echo "Claude will infer the task from branch name: $feature_name"
  user_prompt="Please work on the task indicated by the branch name: $feature_name. Explore the repository, understand the requirements, plan your approach, and implement a solution. Create a pull request when complete."
else
  echo "Task instructions captured."
fi

# Copy CLAUDE.md to worktree if it exists
if [ -f "$project_dir/CLAUDE.md" ]; then
  cp "$project_dir/CLAUDE.md" "$feature_path/CLAUDE.md"
  echo "Copied CLAUDE.md to worktree"
fi

# Create a task-specific CLAUDE.md with instructions
cat > "$feature_path/TASK.md" << TASKEOF
# Task: $feature_name

## Objective
Create a pull request to solve the following task.

## Instructions
$user_prompt

## Workflow
1. Explore the repository and understand the codebase
2. Plan your approach
3. Implement the solution following TDD practices
4. Run tests and ensure everything passes
5. Push your branch and create a pull request

## Guidelines
- Follow the conventions in CLAUDE.md
- Write tests before implementation
- Keep code simple and maintainable
- Run linters and type checkers
- Aim for 80%+ code coverage
TASKEOF

echo "Created TASK.md in worktree with instructions"
echo ""
echo "=========================================="
echo "Worktree ready at: $feature_path"
echo "=========================================="
echo ""

# Navigate to the worktree and start Claude
cd "$feature_path"

echo "Starting Claude session with all tools enabled..."
echo ""

# Check if claude CLI is available and determine correct flags
if command -v claude &> /dev/null; then
  # Create initial prompt for Claude
  initial_prompt="You are working in a git worktree for branch '$feature_name'.

Read TASK.md and CLAUDE.md to understand your task and guidelines.
Then execute the workflow to complete the task and create a pull request.

Start by reading both files to understand what needs to be done."
  
  # Try to detect correct Claude CLI syntax
  # Different Claude CLI implementations may use different flags
  claude_help=$(claude --help 2>&1 || claude -h 2>&1 || echo "")
  
  if echo "$claude_help" | grep -q "allow-all-tools"; then
    # Standard --allow-all-tools flag
    echo "$initial_prompt" | claude --allow-all-tools
  elif echo "$claude_help" | grep -q "\-allow"; then
    # Alternative -allow all syntax
    echo "$initial_prompt" | claude -allow all
  else
    # Fallback: try both, use first that works
    echo "Note: Attempting to determine correct Claude CLI flags..."
    if echo "$initial_prompt" | claude --allow-all-tools 2>/dev/null; then
      : # Success with --allow-all-tools
    elif echo "$initial_prompt" | claude -allow all 2>/dev/null; then
      : # Success with -allow all
    else
      echo "Warning: Could not determine correct Claude CLI flags"
      echo "Please run Claude manually with appropriate flags"
      echo ""
      echo "Suggested commands:"
      echo "  cd $feature_path"
      echo "  claude --allow-all-tools  # or"
      echo "  claude -allow all"
    fi
  fi
else
  echo "Warning: 'claude' CLI not found in PATH"
  echo "Please ensure Claude CLI is installed and available"
  echo ""
  echo "Worktree is ready at: $feature_path"
  echo "Task file: TASK.md"
  echo "Guidelines: CLAUDE.md"
  echo ""
  echo "You can manually start Claude or open the directory in your preferred editor"
fi
