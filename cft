#!/bin/bash

# cft - Claude Feature Tree
# Creates a git worktree and starts a Claude session to work on a feature

set -e

# Check if feature name is provided
if [ -z "$1" ]; then
  echo "Usage: cft <feature-name> [--non-interactive \"prompt\"]"
  echo "Example: cft add-user-authentication"
  echo "         cft add-auth --non-interactive \"Add JWT authentication\""
  exit 1
fi

feature_name=$1
shift

# Check for non-interactive mode (for testing)
non_interactive=false
preset_prompt=""
if [ "$1" = "--non-interactive" ]; then
  non_interactive=true
  shift
  preset_prompt="$@"
fi

# Get project directory and name
project_dir=$(git rev-parse --show-toplevel)
project=$(basename "$project_dir")
cd "$project_dir"

# Create worktree path
feature_path="../$project-$feature_name"

# Check if branch exists, create only if it doesn't
if ! git show-ref --verify --quiet "refs/heads/$feature_name"; then
  git branch "$feature_name"
  echo "✓ Created branch: $feature_name"
else
  echo "✓ Branch already exists: $feature_name"
fi

# Check if worktree exists, create only if it doesn't
if [ ! -d "$feature_path" ]; then
  git worktree add "$feature_path" "$feature_name"
  echo "✓ Created worktree: $feature_path"
else
  echo "✓ Worktree already exists: $feature_path"
fi

# Get user prompt
user_prompt=""

if [ "$non_interactive" = true ]; then
  # Non-interactive mode: use preset prompt
  user_prompt="$preset_prompt"
  echo "✓ Using non-interactive mode"
else
  # Interactive mode: open editor
  prompt_file=$(mktemp)
  
  # Add helpful comments to the prompt file
  cat > "$prompt_file" << PROMPTEOF
# Write your prompt for Claude below. Lines starting with # will be removed.
# If left empty, Claude will determine the task from the branch name: $feature_name
# Save and close the editor when done.

# Branch: $feature_name
# Worktree: $feature_path

PROMPTEOF

  # Open editor (try hx first, fall back to others)
  if command -v hx &> /dev/null; then
    hx "$prompt_file"
  elif command -v helix &> /dev/null; then
    helix "$prompt_file"
  elif command -v nvim &> /dev/null; then
    nvim "$prompt_file"
  elif command -v vim &> /dev/null; then
    vim "$prompt_file"
  else
    nano "$prompt_file"
  fi

  # Read the prompt, removing comment lines
  user_prompt=$(grep -v '^#' "$prompt_file" | sed '/^$/d' | tr '\n' ' ')
  rm -f "$prompt_file"
fi

# If prompt is empty, use branch name as guidance
if [ -z "$user_prompt" ]; then
  user_prompt="Work on the feature: $feature_name. Analyze the codebase, plan the implementation, and create a pull request when complete."
  echo "✓ Using default prompt based on branch name"
else
  echo "✓ Using custom prompt"
fi

# Copy CLAUDE.md to worktree if it exists in main repo
if [ -f "$project_dir/CLAUDE.md" ]; then
  cp "$project_dir/CLAUDE.md" "$feature_path/CLAUDE.md"
  echo "✓ Copied CLAUDE.md to worktree"
fi

# Create a task-specific prompt file in the worktree
cat > "$feature_path/TASK.md" << TASKEOF
# Task for Claude

**Branch:** $feature_name
**Objective:** Create a pull request for this feature

## Instructions

$user_prompt

## Guidelines

1. **Explore** the codebase to understand the context
2. **Plan** your implementation approach
3. **Implement** the feature with proper tests
4. **Test** thoroughly to ensure everything works
5. **Create a PR** when ready for review

Remember to:
- Follow the coding standards in CLAUDE.md
- Write tests before implementation (TDD)
- Keep code simple and maintainable
- Document any non-obvious decisions
TASKEOF

echo "✓ Created TASK.md with instructions"

# Create a simple runner script
cat > "$feature_path/run-claude.sh" << 'RUNEOF'
#!/bin/bash

# This script would run Claude with the appropriate settings
# For now, it shows what would be run

echo "Starting Claude session..."
echo "Working directory: $(pwd)"
echo "Branch: $(git branch --show-current)"
echo ""
echo "Task description in TASK.md:"
cat TASK.md
echo ""
echo "Claude would be run with:"
echo "  claude --allow-all-tools"
echo "  Objective: Create a PR for this feature"
echo ""
echo "Note: Actual Claude invocation depends on your Claude CLI setup"
RUNEOF

chmod +x "$feature_path/run-claude.sh"

echo ""
echo "=========================================="
echo "✓ Claude worktree setup complete!"
echo "=========================================="
echo ""
echo "Worktree: $feature_path"
echo "Branch: $feature_name"
echo ""
echo "Next steps:"
echo "  cd $feature_path"
echo "  cat TASK.md           # Review the task"
echo "  ./run-claude.sh       # Start Claude session"
echo ""
echo "To clean up later:"
echo "  cftr $feature_name"
echo ""
