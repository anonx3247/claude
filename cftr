#!/bin/bash

# cftr - Claude Feature Tool Remove
# Removes git worktree and branch created by cft
# Usage: cftr <branch-name> [--confirm]

set -euo pipefail

# Check if branch name is provided
if [ $# -eq 0 ]; then
  echo "Usage: cftr <branch-name> [--confirm]"
  echo ""
  echo "Removes the worktree and deletes the branch."
  echo "Use --confirm for interactive confirmation prompts."
  echo ""
  echo "Examples:"
  echo "  cftr add-user-authentication"
  echo "  cftr fix/memory-leak --confirm"
  exit 1
fi

feature_name="$1"
confirm_mode=false

# Check for --confirm flag
if [ "${2:-}" = "--confirm" ] || [ "${2:-}" = "-c" ]; then
  confirm_mode=true
fi

# Validate we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
  echo "Error: Not in a git repository"
  exit 1
fi

# Get project directory and name
project_dir=$(git rev-parse --show-toplevel)
project=$(basename "$project_dir")
cd "$project_dir"

# Define paths
feature_path="../${project}-${feature_name}"

echo "Cleaning up Claude worktree for: $feature_name"
echo ""

# Check if worktree exists and remove it
if [ -d "$feature_path" ]; then
  # Check for uncommitted changes
  if [ "$confirm_mode" = true ] && git -C "$feature_path" status --porcelain | grep -q .; then
    echo "⚠ Warning: Worktree has uncommitted changes"
    git -C "$feature_path" status --short
    echo ""
    echo "Continue removing? (y/N): "
    read -r response
    
    if [[ ! "$response" =~ ^[Yy]$ ]]; then
      echo "Aborted. Worktree preserved."
      exit 0
    fi
  fi
  
  echo "Removing worktree at: $feature_path"
  git worktree remove "$feature_path" --force
  echo "✓ Worktree removed"
else
  echo "⚠ Worktree not found at: $feature_path"
fi

# Check if we're currently on the branch we're trying to delete
current_branch=$(git branch --show-current)
if [ "$current_branch" = "$feature_name" ]; then
  echo "Switching away from branch..."
  # Try main, then master, then any other branch
  if git show-ref --verify --quiet refs/heads/main; then
    git checkout main
  elif git show-ref --verify --quiet refs/heads/master; then
    git checkout master
  else
    other_branch=$(git branch | grep -v "^\*" | grep -v "$feature_name" | head -1 | xargs)
    if [ -n "$other_branch" ]; then
      git checkout "$other_branch"
    else
      echo "Error: No other branch to switch to"
      exit 1
    fi
  fi
  echo "✓ Switched away from $feature_name"
fi

# Check if branch exists and delete it
if git show-ref --verify --quiet "refs/heads/$feature_name"; then
  if [ "$confirm_mode" = true ]; then
    # Check if branch has been merged
    if git branch --merged main 2>/dev/null | grep -q "^[* ]*$feature_name$" || \
       git branch --merged master 2>/dev/null | grep -q "^[* ]*$feature_name$"; then
      echo ""
      echo "Branch has been merged."
      echo "Delete the branch? (Y/n): "
      read -r response
      if [[ "$response" =~ ^[Nn]$ ]]; then
        echo "✓ Branch kept: $feature_name"
        exit 0
      fi
      git branch -d "$feature_name"
      echo "✓ Branch deleted"
    else
      echo ""
      echo "⚠ Branch has NOT been merged."
      git log --oneline main.."$feature_name" 2>/dev/null | head -5 || \
        git log --oneline master.."$feature_name" 2>/dev/null | head -5
      echo ""
      echo "Delete anyway? (y/N): "
      read -r response
      if [[ "$response" =~ ^[Yy]$ ]]; then
        git branch -D "$feature_name"
        echo "✓ Branch force-deleted"
      else
        echo "✓ Branch kept: $feature_name"
      fi
    fi
  else
    # Non-interactive mode: just delete the branch
    # Try normal delete first, then force if needed
    if git branch -d "$feature_name" 2>/dev/null; then
      echo "✓ Branch deleted: $feature_name"
    else
      git branch -D "$feature_name"
      echo "✓ Branch force-deleted: $feature_name"
    fi
  fi
else
  echo "⚠ Branch not found: $feature_name"
fi

# Clean up temporary files
rm -f "/tmp/claude-prompt-${feature_name}"-*.md

echo ""
echo "✓ Cleanup complete!"
echo ""
