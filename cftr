#!/bin/bash

# cftr - Claude Feature Tool Remove
# Removes git worktree and optionally deletes the branch created by cft
# Usage: cftr <branch-name>

set -euo pipefail

# Check if branch name is provided
if [ $# -eq 0 ]; then
  echo "Usage: cftr <branch-name>"
  echo ""
  echo "Removes the worktree and optionally deletes the branch."
  echo ""
  echo "Examples:"
  echo "  cftr add-user-authentication"
  echo "  cftr fix/memory-leak-in-parser"
  exit 1
fi

feature_name="$1"

# Validate we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
  echo "Error: Not in a git repository"
  exit 1
fi

# Get project directory and name
project_dir=$(git rev-parse --show-toplevel)
project=$(basename "$project_dir")
cd "$project_dir"

# Define paths
feature_path="../${project}-${feature_name}"

echo "Cleaning up Claude worktree for: $feature_name"
echo ""

# Check if worktree exists and remove it
if [ -d "$feature_path" ]; then
  echo "Removing worktree at: $feature_path"
  
  # Check if there are uncommitted changes
  if git -C "$feature_path" status --porcelain | grep -q .; then
    echo ""
    echo "⚠ Warning: Worktree has uncommitted changes"
    git -C "$feature_path" status --short
    echo ""
    echo "Do you want to continue removing? (y/N): "
    read -r response
    
    if [[ ! "$response" =~ ^[Yy]$ ]]; then
      echo "Aborted. Worktree preserved."
      exit 0
    fi
  fi
  
  git worktree remove "$feature_path" --force
  echo "✓ Worktree removed"
else
  echo "⚠ Worktree not found at: $feature_path"
fi

# Check if branch exists and offer to delete it
if git show-ref --verify --quiet "refs/heads/$feature_name"; then
  echo ""
  echo "Branch '$feature_name' still exists."
  
  # Check if we're currently on this branch
  current_branch=$(git branch --show-current)
  if [ "$current_branch" = "$feature_name" ]; then
    echo "⚠ You are currently on this branch."
    echo "  Switching to main first..."
    git checkout main
    echo "✓ Switched to main"
  fi
  
  # Check if branch has been merged
  if git branch --merged main | grep -q "^[* ]*$feature_name$"; then
    echo ""
    echo "Branch has been merged into main."
    echo "Delete the branch? (Y/n): "
  else
    echo ""
    echo "⚠ Branch has NOT been merged into main."
    echo "  This branch may contain work you want to keep."
    git log --oneline main.."$feature_name" | head -5
    if [ $(git rev-list --count main.."$feature_name") -gt 5 ]; then
      echo "  ... and more commits"
    fi
    echo ""
    echo "Delete the branch anyway? (y/N): "
  fi
  
  read -r response
  
  # Default to 'y' for merged branches, 'n' for unmerged
  if git branch --merged main | grep -q "^[* ]*$feature_name$"; then
    # Merged - default yes
    if [[ "$response" =~ ^[Nn]$ ]]; then
      echo "✓ Branch kept: $feature_name"
    else
      git branch -d "$feature_name"
      echo "✓ Branch deleted"
    fi
  else
    # Not merged - default no
    if [[ "$response" =~ ^[Yy]$ ]]; then
      git branch -D "$feature_name"
      echo "✓ Branch force-deleted"
    else
      echo "✓ Branch kept: $feature_name"
    fi
  fi
else
  echo "⚠ Branch not found: $feature_name"
fi

# Clean up temporary files
rm -f "/tmp/claude-prompt-${feature_name}"-*.md

echo ""
echo "=========================================="
echo "✓ Cleanup Complete!"
echo "=========================================="
echo ""

